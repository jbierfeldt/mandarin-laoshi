"#17A398","lab":"yī ge","cue":"yī → yí before a 4th","kind":"yi"}],"audio":[{"src":"audio/d5.mp3","label":"我也有一個姊姊。 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"d6","spk":"明","g":"m","en":"Do you have an older brother?","cells":[{"ch":"妳","py":"Nǐ","t":3,"s":"你","mk":["33","↗","#17A398"],"said":"ní"},{"ch":"有","py":"yǒu","t":3},{"ch":"哥","py":"gē","t":1},{"ch":"哥","py":"ge","t":5},{"ch":"嗎","py":"ma","t":5,"s":"吗","pz":"？"}],"cues":[{"sym":"↗","col":"#17A398","lab":"nǐ yǒu","cue":"3+3: say ní yǒu","kind":"33"}],"audio":[{"src":"audio/d6.mp3","label":"妳有哥哥嗎？ · REAL","real":true,"score":1.0,"voice":null}]},{"id":"d7","spk":"G","g":"f","en":"I don’t have an older brother or a younger brother. I only have one older sister.","cells":[{"ch":"我","py":"Wǒ","t":3},{"ch":"沒","py":"méi","t":2,"s":"没"},{"ch":"有","py":"yǒu","t":3},{"ch":"哥","py":"gē","t":1},{"ch":"哥","py":"ge","t":5,"pz":"，"},{"ch":"也","py":"yě","t":3},{"ch":"沒","py":"méi","t":2,"s":"没"},{"ch":"有","py":"yǒu","t":3},{"ch":"弟","py":"dì","t":4},{"ch":"弟","py":"di","t":5,"pz":"。"},{"ch":"我","py":"Wǒ","t":3},{"ch":"只","py":"zhǐ","t":3,"mk":["33","↗","#17A398"],"said":"zhí","fc":[["i = buzz","fake i: not ‘ee’ — hold the consonant and voice through it"]]},{"ch":"有","py":"yǒu","t":3},{"ch":"一","py":"yī","t":1,"mk":["yi","↗","#17A398"],"said":"yí"},{"ch":"個","py":"ge","t":5,"s":"个"},{"ch":"姊","py":"jiě","t":3,"s":"姐"},{"ch":"姊","py":"jie","t":5,"s":"姐","pz":"。"}],"cues":[{"sym":"↗","col":"#17A398","lab":"zhǐ yǒu","cue":"3+3: say zhí yǒu","kind":"33"},{"chip":"i = buzz","lab":"zhǐ","cue":"not ‘ee’ — hold the consonant and voice through it"},{"sym":"↗","col":"#17A398","lab":"yī ge","cue":"yī → yí before a 4th","kind":"yi"}],"audio":[{"src":"audio/d7.mp3","label":"我沒有哥哥，也沒有弟弟。我只有一個姊姊。 · REAL","real":true,"score":0.9,"voice":null}]}]},{"type":"vocab","title":"Vocabulary","zh":{"t":"生詞","s":"生词"},"kick":"tap a word · REAL = textbook vocab track","items":[{"id":"v1","grp":"Words 1-12","en":"to have; there is / are","note":"3rd: usually a half-third ↓ before the next word","cells":[{"ch":"有","py":"yǒu","t":3}],"cues":[],"audio":[{"src":"audio/v1.mp3","label":"有 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v2","grp":"Words 1-12","en":"two (counting things)","note":"兩個, not 二個","cells":[{"ch":"兩","py":"liǎng","t":3,"s":"两","fc":[["-ng","-ng: back of tongue up, out through the nose (sing)"]]}],"cues":[{"chip":"-ng","lab":"liǎng","cue":"back of tongue up, out through the nose (sing)"}],"audio":[{"src":"audio/v2.mp3","label":"兩 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v3","grp":"Words 1-12","en":"generic measure word","note":"neutral here; lexical gè","cells":[{"ch":"個","py":"ge","t":5,"s":"个","mk":["nopuff","°","#E67700"]}],"cues":[{"sym":"°","col":"#E67700","lab":"g","cue":"no puff, no voice: sPin","kind":"nopuff"}],"audio":[{"src":"audio/v3.mp3","label":"個 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v4","grp":"Words 1-12","en":"younger brother","note":"d = no puff (sTore)","cells":[{"ch":"弟","py":"dì","t":4,"mk":["nopuff","°","#E67700"]},{"ch":"弟","py":"di","t":5}],"cues":[],"audio":[{"src":"audio/v4.mp3","label":"弟弟 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v5","grp":"Words 1-12","en":"you (male or generic)","note":"妳 nǐ = you (female only), same sound","cells":[{"ch":"你","py":"nǐ","t":3}],"cues":[],"audio":[{"src":"audio/v5.mp3","label":"你 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v6","grp":"Words 1-12","en":"question particle","note":"neutral, light","cells":[{"ch":"嗎","py":"ma","t":5,"s":"吗"}],"cues":[],"audio":[{"src":"audio/v6.mp3","label":"嗎 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v7","grp":"Words 1-12","en":"one","note":"yī / yí / yì by context","cells":[{"ch":"一","py":"yī","t":1}],"cues":[],"audio":[{"src":"audio/v7.mp3","label":"一 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v8","grp":"Words 1-12","en":"older sister","note":"also written 姐姐","cells":[{"ch":"姊","py":"jiě","t":3,"s":"姐","mk":["p1","1","#C92A2A"],"fc":[["ei","ten-E: ei like ‘vein’"]]},{"ch":"姊","py":"jie","t":5,"s":"姐"}],"cues":[{"sym":"1","col":"#C92A2A","lab":"j","cue":"Position 1: tip behind bottom teeth","kind":"p1"},{"chip":"ei","lab":"jiě","cue":"ei like ‘vein’"}],"audio":[{"src":"audio/v8.mp3","label":"姊姊 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v9","grp":"Words 1-12","en":"also","note":"half-third before verbs","cells":[{"ch":"也","py":"yě","t":3}],"cues":[],"audio":[{"src":"audio/v9.mp3","label":"也 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v10","grp":"Words 1-12","en":"older brother","note":"g = no puff (sKill)","cells":[{"ch":"哥","py":"gē","t":1},{"ch":"哥","py":"ge","t":5}],"cues":[],"audio":[{"src":"audio/v10.mp3","label":"哥哥 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v11","grp":"Words 1-12","en":"not (with 有)","note":"ei like ‘vein’","cells":[{"ch":"沒","py":"méi","t":2,"s":"没"}],"cues":[],"audio":[{"src":"audio/v11.mp3","label":"沒 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"v12","grp":"Words 1-12","en":"only","note":"zh = Position 2 + fake i","cells":[{"ch":"只","py":"zhǐ","t":3,"mk":["p2","2","#C92A2A"],"fc":[["i = buzz","fake i: not ‘ee’ — hold the consonant and voice through it"]]}],"cues":[{"sym":"2","col":"#C92A2A","lab":"zh","cue":"Position 2: tip up · shi ≈ ‘shrr’","kind":"p2"},{"chip":"i = buzz","lab":"zhǐ","cue":"not ‘ee’ — hold the consonant and voice through it"}],"audio":[{"src":"audio/v12.mp3","label":"只 · REAL","real":true,"score":0.33,"voice":null}]},{"id":"v13","grp":"Phrases 13","en":"siblings","note":"also 兄弟姐妹","cells":[{"ch":"兄","py":"xiōng","t":1,"mk":["p1","1","#C92A2A"]},{"ch":"弟","py":"dì","t":4},{"ch":"姊","py":"jiě","t":3,"s":"姐","mk":["half","↓","#3B5BDB"]},{"ch":"妹","py":"mèi","t":4}],"cues":[{"sym":"↓","col":"#3B5BDB","lab":"jiě","cue":"zombie: stay low, no rise","kind":"half"}],"audio":[{"src":"audio/v13.mp3","label":"兄弟姊妹 · REAL","real":true,"score":0.85,"voice":null}]},{"id":"v14","grp":"Supplementary 14","en":"younger sister","note":"","cells":[{"ch":"妹","py":"mèi","t":4},{"ch":"妹","py":"mei","t":5}],"cues":[],"audio":[{"src":"audio/v14.mp3","label":"妹妹 · REAL","real":true,"score":1.0,"voice":null}]}]},{"type":"hints","title":"Tricky sounds in Lesson 2","kick":"tap a card to hear it","items":[{"word":{"t":"兩","s":"两"},"py":"liǎng","hint":"l + iang: tongue tip flicks the ridge for l (not n). iang = ‘ee-ahng’, ends -ng (back of tongue). 3rd tone; half-third ↓ before 個.","audio":[{"src":"audio/v2.mp3","label":"兩","real":true}]},{"word":{"t":"姊姊","s":"姐姐"},"py":"jiě jie","hint":"j = Position 1 (tip behind bottom teeth), no puff. ie = ‘ee-eh’ (ten-E, not ‘jay’). Second 姊 light/neutral. Also written 姐姐.","audio":[{"src":"audio/v8.mp3","label":"姊姊","real":true}]},{"word":{"t":"只"},"py":"zhǐ","hint":"zh = Position 2 (tip raised), no puff + fake i: hold a buzzy ‘jrr’, never ‘jee’. Contrast j in 姊 jiě (Position 1).","audio":[{"src":"audio/v12.mp3","label":"只","real":true}]},{"word":{"t":"兄弟姊妹","s":"兄弟姐妹"},"py":"xiōng dì jiě mèi","hint":"兄 xiōng: x = Position 1 + iong ≈ ‘shyoong’ (round lips, ends -ng). 弟 d = no puff. 妹 mèi: ei like ‘vein’.","audio":[{"src":"audio/v13.mp3","label":"兄弟姊妹","real":true}]},{"word":{"t":"有"},"py":"yǒu","hint":"you = i(o)u: ‘yo’ + a hint of ‘oo’ (not English ‘you’). Usually a low half-third ↓; 3+3 rises in 也有 / 我有 / 只有 / 你有.","audio":[{"src":"audio/v1.mp3","label":"有","real":true}]},{"word":{"t":"沒","s":"没"},"py":"méi","hint":"m + ei (‘may’) rising 2nd tone. With 有 the negative is 沒, never 不.","audio":[{"src":"audio/v11.mp3","label":"沒","real":true}]},{"word":{"t":"弟弟"},"py":"dì di","hint":"d = no puff (sTore). vs 他 tā / t: big puff. Textbook focus initials this lesson: d t n l.","audio":[{"src":"audio/v4.mp3","label":"弟弟","real":true}]},{"word":{"t":"你"},"py":"nǐ","hint":"n vs l: tip on the ridge, air through the nose for n (你), out the sides for l (兩). 你好 is said ní hǎo (3+3).","audio":[{"src":"audio/v5.mp3","label":"你","real":true}]},{"word":{"t":"個","s":"个"},"py":"ge","hint":"Light neutral ‘guh’: e is a back unrounded ‘uh’, g = no puff. Lexically gè, which is why 一個 is yí ge.","audio":[{"src":"audio/v3.mp3","label":"個","real":true}]},{"word":{"t":"一"},"py":"yī","hint":"Alone: yī (high flat). In 一個: yí (rises, because 個 is gè). Textbook lists yī / yí / yì.","audio":[{"src":"audio/v7.mp3","label":"一","real":true}]}],"cards":[["Textbook pinyin focus: finals ao, ei","ao ≈ ‘ow’ (好 hǎo); ei ≈ ‘ay’ (妹 mèi, 沒 méi). Tone marks sit on the main vowel in a-o-e-i-u-ü order: mèi, liǎng, hǎo."]]},{"type":"cards","title":"Grammar","items":[["有 / 沒有 — have / not have (textbook Grammar 1)","沒 goes in front of 有 to negate it: S + 沒 + 有 + O. 我有哥哥。我有妹妹。我沒有哥哥。Gloria 沒有哥哥，也沒有弟弟。Gloria 只有一個姊姊。 [ours] With 有, the negative is always 沒, never 不."],["嗎 — yes/no questions (Grammar 2)","Statement + 嗎？ 您姓王嗎？ 你是美國人嗎？ 你叫明文嗎？ 你有哥哥嗎？ 你有兄弟姊妹嗎？ Word order doesn’t change."],["個 — the generic measure word (Grammar 3)","Number + 個 + noun: 一個哥哥, 兩個哥哥, 一個妹妹, 兩個妹妹. 我有一個姊姊。我有兩個弟弟。 Use 兩 (not 二) before a measure word."],["也 — also (Grammar 4)","S + 也 + V + O, after the subject and before the verb: 我也是臺灣人。他姓王，我也姓王。明文有姊姊，Gloria 也有姊姊。Gloria 是美國人，Mary 也是。"],["呢 — ‘and you?’ (from the dialogue, met in Lesson 1)","妳呢？ bounces the same question back: 我有一個姊姊，兩個弟弟。妳呢？"]]},{"type":"cards","title":"Sound notes","items":[["Textbook pinyin focus: initials d t n l, finals ao ei","d (no puff) vs t (big puff): 弟 dì vs 他 tā. n vs l: 你 nǐ / 妳 nǐ vs 兩 liǎng. ei: 妹 mèi, 沒 méi. ao: 好 hǎo. Tone marks go on the main vowel (a o e i u ü): mèi, liǎng; i loses its dot: dì. (textbook p.24)"],["一 changes tone (yī / yí / yì)","Textbook lists 一 as yī / yí / yì. 一個 is said yí ge, because 個 is lexically 4th (gè) even though it’s light here. Alone or counting: yī. [ours] Before 1st/2nd/3rd: yì (later lessons)."],["3+3 → 2+3: 你好, 也有, 我有, 只有, 我也","你好 nǐ hǎo is said ní hǎo (textbook prints it that way). 我也有 / 我只有 chains of 3rds: the first ones rise or go half-third; only the last full dip at a pause. [ours] Don’t sweat perfection: avoid three full dips in a row."],["Neutral reduplicated kin terms","弟弟 dì di, 姊姊 jiě jie, 哥哥 gē ge, 妹妹 mèi mei: the second syllable is short and light. After 3rd (姊姊) the neutral is a bit higher; after 4th (弟弟, 妹妹) it drops low."]]},{"type":"lines","title":"Your turn","zh":null,"kick":"tap to hear, then say it yourself","items":[{"id":"y1","spk":"我","g":"m","en":"I’m Tian Jiasen. I’m American.","cells":[{"ch":"我","py":"Wǒ","t":3,"mk":["half","↓","#3B5BDB"],"fc":[["uo","uo: ‘oo’ opening to ‘aw’ (wǒ ≈ ‘waw’, no r)"]]},{"ch":"叫","py":"jiào","t":4,"mk":["p1","1","#C92A2A"]},{"ch":"田","py":"Tián","t":2,"mk":["puff","ʰ","#E67700"],"fc":[["-n","-n: tip ends on the ridge behind top teeth (ban)"]]},{"ch":"佳","py":"Jiā","t":1},{"ch":"森","py":"sēn","t":1,"fc":[["e = uh","short-E: en/eng ≈ quick ‘uh’ (ba-NA-na)"]],"pz":"。"},{"ch":"我","py":"Wǒ","t":3},{"ch":"是","py":"shì","t":4,"mk":["p2","2","#C92A2A"],"fc":[["i = buzz","fake i: not ‘ee’ — hold the consonant and voice through it"]]},{"ch":"美","py":"Měi","t":3,"fc":[["ei","ten-E: ei like ‘vein’"]]},{"ch":"國","py":"guó","t":2,"s":"国","mk":["nopuff","°","#E67700"]},{"ch":"人","py":"rén","t":2,"mk":["p2","2","#C92A2A"],"pz":"。"}],"cues":[{"sym":"↓","col":"#3B5BDB","lab":"wǒ","cue":"zombie: stay low, no rise","kind":"half"},{"chip":"uo","lab":"wǒ","cue":"‘oo’ opening to ‘aw’ (wǒ ≈ ‘waw’, no r)"},{"sym":"1","col":"#C92A2A","lab":"j","cue":"Position 1: tip behind bottom teeth","kind":"p1"},{"sym":"ʰ","col":"#E67700","lab":"t","cue":"big puff of air (hand test)","kind":"puff"},{"chip":"-n","lab":"tián","cue":"tip ends on the ridge behind top teeth (ban)"},{"chip":"e = uh","lab":"sēn","cue":"en/eng ≈ quick ‘uh’ (ba-NA-na)"},{"sym":"2","col":"#C92A2A","lab":"sh","cue":"Position 2: tip up · shi ≈ ‘shrr’","kind":"p2"},{"chip":"i = buzz","lab":"shì","cue":"not ‘ee’ — hold the consonant and voice through it"},{"chip":"ei","lab":"měi","cue":"ei like ‘vein’"},{"sym":"°","col":"#E67700","lab":"g","cue":"no puff, no voice: sPin","kind":"nopuff"}],"audio":[{"src":"audio/y1.mp3","label":"我叫田佳森。我是美國人。 · synthetic","real":false,"score":null,"voice":"male"}]},{"id":"y2","spk":"","g":"m","en":"Do you have siblings? (to ask your Taiwan host)","cells":[{"ch":"你","py":"Nǐ","t":3,"mk":["33","↗","#17A398"],"said":"ní"},{"ch":"有","py":"yǒu","t":3},{"ch":"兄","py":"xiōng","t":1,"mk":["p1","1","#C92A2A"],"fc":[["-ng","-ng: back of tongue up, out through the nose (sing)"]]},{"ch":"弟","py":"dì","t":4,"mk":["nopuff","°","#E67700"]},{"ch":"姊","py":"jiě","t":3,"s":"姐"},{"ch":"妹","py":"mèi","t":4},{"ch":"嗎","py":"ma","t":5,"s":"吗","pz":"？"}],"cues":[{"sym":"↗","col":"#17A398","lab":"nǐ yǒu","cue":"3+3: say ní yǒu","kind":"33"},{"chip":"-ng","lab":"xiōng","cue":"back of tongue up, out through the nose (sing)"}],"audio":[{"src":"audio/y2.mp3","label":"你有兄弟姊妹嗎？ · synthetic","real":false,"score":null,"voice":"male"}]},{"id":"y3","spk":"","g":"m","en":"Are you Taiwanese?","cells":[{"ch":"你","py":"Nǐ","t":3},{"ch":"是","py":"shì","t":4},{"ch":"臺","py":"Tái","t":2,"s":"台"},{"ch":"灣","py":"wān","t":1,"s":"湾"},{"ch":"人","py":"rén","t":2},{"ch":"嗎","py":"ma","t":5,"s":"吗","pz":"？"}],"cues":[],"audio":[{"src":"audio/y3.mp3","label":"你是臺灣人嗎？ · synthetic","real":false,"score":null,"voice":"male"}]},{"id":"y4","spk":"","g":"m","en":"I’m also American.","cells":[{"ch":"我","py":"Wǒ","t":3,"mk":["33","↗","#17A398"],"said":"wó"},{"ch":"也","py":"yě","t":3},{"ch":"是","py":"shì","t":4},{"ch":"美","py":"Měi","t":3},{"ch":"國","py":"guó","t":2,"s":"国"},{"ch":"人","py":"rén","t":2,"pz":"。"}],"cues":[{"sym":"↗","col":"#17A398","lab":"wǒ yě","cue":"3+3: say wó yě","kind":"33"}],"audio":[{"src":"audio/y4.mp3","label":"我也是美國人。 · synthetic","real":false,"score":null,"voice":"male"}]},{"id":"y5","spk":"","g":"m","en":"I have one older brother. (template: swap in your real family)","cells":[{"ch":"我","py":"Wǒ","t":3,"mk":["33","↗","#17A398"],"said":"wó"},{"ch":"有","py":"yǒu","t":3},{"ch":"一","py":"yī","t":1,"mk":["yi","↗","#17A398"],"said":"yí"},{"ch":"個","py":"ge","t":5,"s":"个"},{"ch":"哥","py":"gē","t":1},{"ch":"哥","py":"ge","t":5,"pz":"。"}],"cues":[{"sym":"↗","col":"#17A398","lab":"wǒ yǒu","cue":"3+3: say wó yǒu","kind":"33"},{"sym":"↗","col":"#17A398","lab":"yī ge","cue":"yī → yí before a 4th","kind":"yi"}],"audio":[{"src":"audio/y5.mp3","label":"我有一個哥哥。 · synthetic","real":false,"score":null,"voice":"male"}]},{"id":"y6","spk":"","g":"m","en":"I have no younger brother and no younger sister. (template)","cells":[{"ch":"我","py":"Wǒ","t":3},{"ch":"沒","py":"méi","t":2,"s":"没"},{"ch":"有","py":"yǒu","t":3},{"ch":"弟","py":"dì","t":4},{"ch":"弟","py":"di","t":5,"pz":"，"},{"ch":"也","py":"yě","t":3},{"ch":"沒","py":"méi","t":2,"s":"没"},{"ch":"有","py":"yǒu","t":3},{"ch":"妹","py":"mèi","t":4},{"ch":"妹","py":"mei","t":5,"pz":"。"}],"cues":[],"audio":[{"src":"audio/y6.mp3","label":"我沒有弟弟，也沒有妹妹。 · synthetic","real":false,"score":null,"voice":"male"}]}]},{"type":"lines","title":"Review from Lesson 1","zh":null,"kick":"real Lesson 1 clips · tap to hear","items":[{"id":"r1","spk":"","g":"m","en":"Hello. (polite)","cells":[{"ch":"您","py":"Nín","t":2,"fc":[["-n","-n: tip ends on the ridge behind top teeth (ban)"]]},{"ch":"好","py":"hǎo","t":3,"mk":["h","~","#E67700"],"pz":"。"}],"cues":[{"chip":"-n","lab":"nín","cue":"tip ends on the ridge behind top teeth (ban)"},{"sym":"~","col":"#E67700","lab":"h","cue":"light scratch at the back","kind":"h"}],"audio":[{"src":"audio/r1.mp3","label":"您好。 · REAL","real":true,"score":1.0,"voice":null}]},{"id":"r2","spk":"","g":"m","en":"My surname is Wang. May I ask your surname?","cells":[{"ch":"我","py":"Wǒ","t":3,"mk":["half","↓","#3B5BDB"],"fc":[["uo","uo: ‘oo’ opening to ‘aw’ (wǒ ≈ ‘waw’, no r)"]]},{"ch":"姓","py":"xìng","t":4,"mk":["p1","1","#C92A2A"],"fc":[["-ng","-ng: back of tongue up, out through the nose (sing)"]]},{"ch":"王","py":"Wáng","t":2,"pz":"，"},{"ch":"請","py":"qǐng","t":3,"s":"请","mk":["p1","1","#C92A2A"]},{"ch":"問","py":"wèn","t":4,"s":"问","fc":[["e = uh","short-E: en/eng ≈ quick ‘uh’ (ba-NA-na)"]],"pz":"，"},{"ch":"您","py":"nín","t":2},{"ch":"貴","py":"guì","t":4,"s":"贵","mk":["nopuff","°","#E67700"],"fc":[["ei","ten-E: ei like ‘vein’"],["u(e)i","hidden vowel: -ui = u(e)i, -iu = i(o)u, -un = u(e)n"]]},{"ch":"姓","py":"xìng","t":4,"pz":"？"}],"cues":[{"sym":"↓","col":"#3B5BDB","lab":"wǒ","cue":"zombie: stay low, no rise","kind":"half"},{"chip":"uo","lab":"wǒ","cue":"‘oo’ opening to ‘aw’ (wǒ ≈ ‘waw’, no r)"},{"sym":"1","col":"#C92A2A","lab":"x","cue":"Position 1: tip behind bottom teeth","kind":"p1"},{"chip":"-ng","lab":"xìng","cue":"back of tongue up, out through the nose (sing)"},{"chip":"e = uh","lab":"wèn","cue":"en/eng ≈ quick ‘uh’ (ba-NA-na)"},{"sym":"°","col":"#E67700","lab":"g","cue":"no puff, no voice: sPin","kind":"nopuff"},{"chip":"ei","lab":"guì","cue":"ei like ‘vein’"},{"chip":"u(e)i","lab":"guì","cue":"-ui = u(e)i, -iu = i(o)u, -un = u(e)n"}],"audio":[{"src":"audio/r2.mp3","label":"我姓王，請問，您貴姓？ · REAL","real":true,"score":1.0,"voice":null}]},{"id":"r3","spk":"","g":"m","en":"I’m Mingwen. May I ask what country you’re from?","cells":[{"ch":"我","py":"Wǒ","t":3},{"ch":"叫","py":"jiào","t":4,"mk":["p1","1","#C92A2A"]},{"ch":"明","py":"Míng","t":2},{"ch":"文","py":"wén","t":2,"pz":"。"},{"ch":"請","py":"Qǐng","t":3,"s":"请"},{"ch":"問","py":"wèn","t":4,"s":"问","pz":"，"},{"ch":"您","py":"nín","t":2},{"ch":"是","py":"shì","t":4,"mk":["p2","2","#C92A2A"],"fc":[["i = buzz","fake i: not ‘ee’ — hold the consonant and voice through it"]]},{"ch":"哪","py":"nǎ","t":3},{"ch":"國","py":"guó","t":2,"s":"国"},{"ch":"人","py":"rén","t":2,"mk":["p2","2","#C92A2A"],"pz":"？"}],"cues":[{"sym":"2","col":"#C92A2A","lab":"sh","cue":"Position 2: tip up · shi ≈ ‘shrr’","kind":"p2"},{"chip":"i = buzz","lab":"shì","cue":"not ‘ee’ — hold the consonant and voice through it"}],"audio":[{"src":"audio/r3.mp3","label":"我叫明文。請問，您是哪國人？ · REAL","real":true,"score":1.0,"voice":null}]},{"id":"r4","spk":"","g":"m","en":"I’m American. And you?","cells":[{"ch":"我","py":"Wǒ","t":3},{"ch":"是","py":"shì","t":4},{"ch":"美","py":"Měi","t":3},{"ch":"國","py":"guó","t":2,"s":"国"},{"ch":"人","py":"rén","t":2,"pz":"。"},{"ch":"您","py":"Nín","t":2},{"ch":"呢","py":"ne","t":5,"pz":"？"}],"cues":[],"audio":[{"src":"audio/r4.mp3","label":"我是美國人。您呢？ · REAL","real":true,"score":1.0,"voice":null}]}]},{"type":"quiz","title":"Self-quiz","kick":"say it aloud, then tap to reveal","items":[["Q1. Ask: ‘Do you have siblings?’","A: 你有兄弟姊妹嗎？ Nǐ yǒu xiōngdì jiěmèi ma?"],["Q2. Say: ‘I have one older sister and two younger brothers.’","A: 我有一個姊姊，兩個弟弟。Wǒ yǒu yí ge jiějie, liǎng ge dìdi."],["Q3. Negate 我有哥哥。","A: 我沒有哥哥。(沒, not 不)"],["Q4. ‘I’m also American.’ Where does 也 go?","A: 我也是美國人。(after the subject, before the verb)"],["Q5. Turn 你是臺灣人。 into a question.","A: 你是臺灣人嗎？"],["Q6. 一個 or 二個 / 兩個? ‘two younger brothers’","A: 兩個弟弟 liǎng ge dìdi"],["Q7. Which has the big puff: 弟 dì or 他 tā?","A: 他 tā (t = puff; d = no puff)"]]}],"schema":1,"date":"2026-10-31T19:15-04:00"}