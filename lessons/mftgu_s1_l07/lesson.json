al)","real":true,"score":0.8,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d10","spk":"M","g":"m","en":"Well, this one...","cells":[{"ch":"這","py":"Zhè","t":4,"s":"这","mk":["p2","2","#C92A2A"]},{"ch":"個","py":"ge","t":5,"s":"个"},{"ch":"嘛","py":"ma……","t":5},{"ch":"…","py":"","t":5},{"ch":"…","py":"","t":5}],"cues":[],"audio":[{"src":"audio/Fd10.mp3","label":"這個嘛…… · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d11","spk":"L","g":"f","en":"Why?! Tell me!","cells":[{"ch":"為","py":"Wèi","t":4,"s":"为"},{"ch":"什","py":"shén","t":2},{"ch":"麼","py":"me","t":5,"s":"么","pz":"！"},{"ch":"你","py":"Nǐ","t":3},{"ch":"跟","py":"gēn","t":1},{"ch":"我","py":"wǒ","t":3},{"ch":"說","py":"shuō","t":1,"s":"说","pz":"！"}],"cues":[],"audio":[{"src":"audio/Fd11.mp3","label":"為什麼？！你跟我說！ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d12","spk":"M","g":"m","en":"...You don't like staying at home?","cells":[{"ch":"…","py":"……Nǐ","t":3},{"ch":"…","py":"bù","t":4},{"ch":"你","py":"xǐ","t":3,"mk":["p1","1","#C92A2A"]},{"ch":"不","py":"huan","t":5,"mk":["h","~","#E67700"]},{"ch":"喜","py":"dāi","t":1},{"ch":"歡","py":"zài","t":4,"s":"欢"},{"ch":"待","py":"jiā","t":1},{"ch":"在","py":"lǐ","t":3},{"ch":"家","py":"","t":5},{"ch":"裡","py":"","t":5,"s":"里","pz":"？"}],"cues":[{"sym":"~","col":"#E67700","lab":"h","cue":"light scratch at the back","kind":"h"}],"audio":[{"src":"audio/Fd12.mp3","label":"……你不喜歡待在家裡？ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d13","spk":"L","g":"f","en":"Nobody likes staying at home.","cells":[{"ch":"沒","py":"Méi","t":2,"s":"没"},{"ch":"有","py":"yǒu","t":3},{"ch":"人","py":"rén","t":2,"mk":["p2","2","#C92A2A"]},{"ch":"喜","py":"xǐ","t":3},{"ch":"歡","py":"huan","t":5,"s":"欢"},{"ch":"待","py":"dāi","t":1},{"ch":"在","py":"zài","t":4},{"ch":"家","py":"jiā","t":1},{"ch":"裡","py":"lǐ","t":3,"s":"里"},{"ch":"啊","py":"a","t":5}],"cues":[],"audio":[{"src":"audio/Fd13.mp3","label":"沒有人喜歡待在家裡啊 · dialogue (natural)","real":true,"score":0.96,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d14","spk":"M","g":"m","en":"...Do you want to look at the cat a bit more?","cells":[{"ch":"…","py":"……Nǐ","t":3,"mk":["33","↗","#17A398"],"said":"……ní"},{"ch":"…","py":"xiǎng","t":3},{"ch":"你","py":"zài","t":4},{"ch":"想","py":"kàn","t":4},{"ch":"再","py":"yī","t":1},{"ch":"看","py":"xià","t":4},{"ch":"一","py":"māo","t":1,"mk":["yi","↗","#17A398"],"said":"yì"},{"ch":"下","py":"mī","t":1},{"ch":"貓","py":"ma","t":5,"s":"猫"},{"ch":"咪","py":"","t":5},{"ch":"嗎","py":"","t":5,"s":"吗","pz":"？"}],"cues":[{"sym":"↗","col":"#17A398","lab":"……Nǐ xiǎng","cue":"3+3: say ……Ní xiǎng","kind":"33"},{"sym":"↗","col":"#17A398","lab":"māo mī","cue":"yī → yì before a 1st","kind":"yi"}],"audio":[{"src":"audio/Fd14.mp3","label":"……你想再看一下貓咪嗎？ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d15","spk":"L","g":"f","en":"Fine.","cells":[{"ch":"好","py":"Hǎo","t":3},{"ch":"吧","py":"ba","t":5}],"cues":[],"audio":[{"src":"audio/Fd15.mp3","label":"好吧 · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1}]},{"type":"vocab","title":"Vocabulary","zh":{"t":"生詞","s":"生词"},"kick":"official episode list · glosses as published, pinyin/notes ours","items":[{"id":"v1","en":"but","note":"4th, full fall; d = no puff","cells":[{"ch":"但","py":"dàn","t":4,"mk":["nopuff","°","#E67700"],"fc":[["-n","-n: tip ends on the ridge behind top teeth (ban)"]]}],"cues":[{"sym":"°","col":"#E67700","lab":"d","cue":"no puff, no voice: sPin","kind":"nopuff"},{"chip":"-n","lab":"dàn","cue":"tip ends on the ridge behind top teeth (ban)"}],"audio":[{"src":"audio/Vv1.mp3","label":"但 · synthetic","real":false,"voice":"female"}]},{"id":"v2","en":"but","note":"4+4: the first drops only halfway, second falls fully","cells":[{"ch":"但","py":"dàn","t":4},{"ch":"是","py":"shì","t":4,"mk":["p2","2","#C92A2A"],"fc":[["i = buzz","fake i: not ‘ee’ — hold the consonant and voice through it"]]}],"cues":[{"sym":"2","col":"#C92A2A","lab":"sh","cue":"Position 2: tip up · shi ≈ ‘shrr’","kind":"p2"},{"chip":"i = buzz","lab":"shì","cue":"not ‘ee’ — hold the consonant and voice through it"}],"audio":[{"src":"audio/Vv2.mp3","label":"但是 · synthetic","real":false,"voice":"female"}]},{"id":"v3","en":"yesterday","note":"2+1: rise then high plateau; z = no puff","cells":[{"ch":"昨","py":"zuó","t":2,"mk":["p3","3","#C92A2A"],"fc":[["uo","uo: ‘oo’ opening to ‘aw’ (wǒ ≈ ‘waw’, no r)"]]},{"ch":"天","py":"tiān","t":1,"mk":["puff","ʰ","#E67700"]}],"cues":[{"sym":"3","col":"#C92A2A","lab":"z","cue":"Position 3: tip on top teeth","kind":"p3"},{"chip":"uo","lab":"zuó","cue":"‘oo’ opening to ‘aw’ (wǒ ≈ ‘waw’, no r)"},{"sym":"ʰ","col":"#E67700","lab":"t","cue":"big puff of air (hand test)","kind":"puff"}],"audio":[{"src":"audio/Vv3.mp3","label":"昨天 · synthetic","real":false,"voice":"female"}]},{"id":"v4","en":"different","note":"不 is bù; 一 here reads yī in a list, but 不一樣 is said bù yí yàng (一 rises before 4th 樣)","cells":[{"ch":"不","py":"bù","t":4,"mk":["nopuff","°","#E67700"]},{"ch":"一","py":"yī","t":1,"mk":["yi","↗","#17A398"],"said":"yí"},{"ch":"樣","py":"yàng","t":4,"s":"样","fc":[["-ng","-ng: back of tongue up, out through the nose (sing)"]]}],"cues":[{"sym":"↗","col":"#17A398","lab":"yī yàng","cue":"yī → yí before a 4th","kind":"yi"},{"chip":"-ng","lab":"yàng","cue":"back of tongue up, out through the nose (sing)"}],"audio":[{"src":"audio/Vv4.mp3","label":"不一樣 · synthetic","real":false,"voice":"female"}]},{"id":"v5","en":"cat","note":"1+1 plateau (Taiwan speakers also say māo mī flat)","cells":[{"ch":"貓","py":"māo","t":1,"s":"猫"},{"ch":"咪","py":"mī","t":1}],"cues":[],"audio":[{"src":"audio/Vv5.mp3","label":"貓咪 · synthetic","real":false,"voice":"female"}]},{"id":"v6","en":"why","note":"4-2-neutral: fall, rise, light 麼","cells":[{"ch":"為","py":"wèi","t":4,"s":"为","fc":[["ei","ten-E: ei like ‘vein’"]]},{"ch":"什","py":"shén","t":2,"fc":[["e = uh","short-E: en/eng ≈ quick ‘uh’ (ba-NA-na)"]]},{"ch":"麼","py":"me","t":5,"s":"么"}],"cues":[{"chip":"ei","lab":"wèi","cue":"ei like ‘vein’"},{"chip":"e = uh","lab":"shén","cue":"en/eng ≈ quick ‘uh’ (ba-NA-na)"}],"audio":[{"src":"audio/Vv6.mp3","label":"為什麼 · synthetic","real":false,"voice":"female"}]},{"id":"v7","en":"every day","note":"3+1: 每 stays a low half-third before the plateau","cells":[{"ch":"每","py":"měi","t":3,"mk":["half","↓","#3B5BDB"]},{"ch":"天","py":"tiān","t":1}],"cues":[{"sym":"↓","col":"#3B5BDB","lab":"měi","cue":"zombie: stay low, no rise","kind":"half"}],"audio":[{"src":"audio/Vv7.mp3","label":"每天 · synthetic","real":false,"voice":"female"}]},{"id":"v8","en":"to ask","note":"4th; 問 vs 吻 (wěn) is the tone-minimal pair in the intro","cells":[{"ch":"問","py":"wèn","t":4,"s":"问"}],"cues":[],"audio":[{"src":"audio/Vv8.mp3","label":"問 · synthetic","real":false,"voice":"female"}]},{"id":"v9","en":"can, to be able to","note":"3+3 → ké yǐ: first 3rd rises","cells":[{"ch":"可","py":"kě","t":3,"mk":["33","↗","#17A398"],"said":"ké"},{"ch":"以","py":"yǐ","t":3}],"cues":[{"sym":"↗","col":"#17A398","lab":"kě yǐ","cue":"3+3: say ké yǐ","kind":"33"}],"audio":[{"src":"audio/Vv9.mp3","label":"可以 · synthetic","real":false,"voice":"female"}]},{"id":"v10","en":"to go","note":"4th; q = aspirated (Position 3 puff)","cells":[{"ch":"去","py":"qù","t":4,"mk":["p1","1","#C92A2A"]}],"cues":[{"sym":"1","col":"#C92A2A","lab":"q","cue":"Position 1: tip behind bottom teeth","kind":"p1"}],"audio":[{"src":"audio/Vv10.mp3","label":"去 · synthetic","real":false,"voice":"female"}]},{"id":"v11","en":"out","note":"1st; ch retroflex + puff","cells":[{"ch":"出","py":"chū","t":1,"mk":["p2","2","#C92A2A"]}],"cues":[],"audio":[{"src":"audio/Vv11.mp3","label":"出 · synthetic","real":false,"voice":"female"}]},{"id":"v12","en":"to stay","note":"1st tone in Taiwan usage (dāi), not dài; d = no puff","cells":[{"ch":"待","py":"dāi","t":1}],"cues":[],"audio":[{"src":"audio/Vv12.mp3","label":"待 · synthetic","real":false,"voice":"female"}]},{"id":"v13","en":"at home","note":"1+3, 裡 often light → jiā li","cells":[{"ch":"家","py":"jiā","t":1,"mk":["p1","1","#C92A2A"]},{"ch":"裡","py":"lǐ","t":3,"s":"里"}],"cues":[],"audio":[{"src":"audio/Vv13.mp3","label":"家裡 · synthetic","real":false,"voice":"female"}]},{"id":"v14","en":"this one","note":"4 + light 個","cells":[{"ch":"這","py":"zhè","t":4,"s":"这","mk":["p2","2","#C92A2A"]},{"ch":"個","py":"ge","t":5,"s":"个","mk":["nopuff","°","#E67700"]}],"cues":[],"audio":[{"src":"audio/Vv14.mp3","label":"這個 · synthetic","real":false,"voice":"female"}]},{"id":"v15","en":"to want, would like to","note":"3rd; half-third before 再 (4th)","cells":[{"ch":"想","py":"xiǎng","t":3,"mk":["p1","1","#C92A2A"]}],"cues":[],"audio":[{"src":"audio/Vv15.mp3","label":"想 · synthetic","real":false,"voice":"female"}]}]},{"type":"cards","title":"Listening notes","items":[["The four tones are English melodies you already own.","The episode's key idea: the four tones are melodies English already uses in intonation ('Yeah…', 'Really?', 'Well…', 'Sh*t!' are the host's mnemonics), so imitate melody and mood together, not just the sounds. 問 wèn (ask) vs 吻 wěn (kiss) is the pair behind 'can I ask you?' vs 'can I smell you?'. Also 'ma': mà (scold) vs má (hemp)."],["為什麼 wèi shén me: fall, rise, light.","4-2-neutral. 什 rises, 麼 drops to a light, short syllable; in the dialogue the bare 為什麼？ question uses a big expressive pitch range. Don't flatten 什 into a 1st tone."],["一 and 不 before a falling tone.","不一樣 is bù yí yàng, not bù yī yàng: 一 surfaces as a rise before the 4th 樣 (as in 一下, 一個). 不 stays bù here because 一 is not a 4th. 再看一下 → zài kàn yí xià, same rule."],["3+3 rises: 可以, 你想, 你每天…","可以 is ké yǐ and 你想 is ní xiǎng (the first 3rd of a pair rises). Before non-3rd syllables (每天, 想再) a 3rd is a low half-third [21] and the next syllable launches from the floor."],["Neutral tones: 麼, 嘛, 吧, 個, 歡, 裡.","Light syllables are short, soft, and take their pitch from the preceding tone: 為什麼 (wèi shén me), 這個嘛 (zhè ge ma, falling start then light-light), 好吧 (hǎo ba: a half-third 好 then a lower ba), 喜歡 (xǐ huan), 家裡 (jiā li)."],["啊 → ya after -i / -a (assimilation).","After 對 (duì) and 裡 (lǐ) the 啊 is heard as ya (對呀, 待在家裡呀), and the transcriber wrote 呀. After -e/-ng it can stay a (沒有為什麼啊)."],["Aspiration: q, k, t, ch vs z, d, j.","去 qù, 咖 kā and 出 chū are puffed; 但 dàn, 待 dāi, 昨 zuó are not. Hold a tissue: Position 3 vs Position 1 contrast."]]}],"schema":1,"date":"2026-11-09T08:06-05:00"}