ī → yí before a 4th","kind":"yi"},{"chip":"-ng","lab":"yàng","cue":"back of tongue up, out through the nose (sing)"}],"audio":[{"src":"audio/Fd3.mp3","label":"但是，今天的咖啡店跟昨天的不一樣 · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d4","spk":"M","g":"m","en":"Right, look: today's coffee shop has a cat!","cells":[{"ch":"對","py":"Duì","t":4,"s":"对","pz":"，"},{"ch":"你","py":"nǐ","t":3},{"ch":"看","py":"kàn","t":4,"pz":"，"},{"ch":"今","py":"jīn","t":1},{"ch":"天","py":"tiān","t":1},{"ch":"的","py":"de","t":5},{"ch":"咖","py":"kā","t":1},{"ch":"啡","py":"fēi","t":1},{"ch":"店","py":"diàn","t":4},{"ch":"有","py":"yǒu","t":3},{"ch":"貓","py":"māo","t":1,"s":"猫"},{"ch":"咪","py":"mī","t":1,"pz":"！"}],"cues":[],"audio":[{"src":"audio/Fd4.mp3","label":"對，你看，今天的咖啡店有貓咪！ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d5","spk":"L","g":"f","en":"Why?","cells":[{"ch":"為","py":"Wèi","t":4,"s":"为"},{"ch":"什","py":"shén","t":2},{"ch":"麼","py":"me","t":5,"s":"么","pz":"？"}],"cues":[],"audio":[{"src":"audio/Fd5.mp3","label":"為什麼？ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d6","spk":"M","g":"m","en":"There's no why.","cells":[{"ch":"沒","py":"Méi","t":2,"s":"没"},{"ch":"有","py":"yǒu","t":3},{"ch":"為","py":"wèi","t":4,"s":"为"},{"ch":"什","py":"shén","t":2},{"ch":"麼","py":"me","t":5,"s":"么"},{"ch":"啊","py":"a","t":5}],"cues":[],"audio":[{"src":"audio/Fd6.mp3","label":"沒有為什麼啊 · dialogue (natural)","real":true,"score":0.94,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d7","spk":"L","g":"f","en":"Why do you go to the coffee shop every day?","cells":[{"ch":"為","py":"Wèi","t":4,"s":"为"},{"ch":"什","py":"shén","t":2},{"ch":"麼","py":"me","t":5,"s":"么"},{"ch":"你","py":"nǐ","t":3,"mk":["33","↗","#17A398"],"said":"ní"},{"ch":"每","py":"měi","t":3},{"ch":"天","py":"tiān","t":1},{"ch":"都","py":"dōu","t":1},{"ch":"去","py":"qù","t":4,"mk":["p1","1","#C92A2A"]},{"ch":"咖","py":"kā","t":1},{"ch":"啡