,"en":"OK"},{"t":"啊","py":"a","en":"particle"},{"t":"你","py":"nǐ","en":"you"},{"t":"開車","py":"kāi chē","en":"to drive","s":"开车"},{"t":"嗎","py":"ma","en":"question","s":"吗"}],"audio":[{"src":"audio/Fd7.mp3","label":"好啊，你開車嗎？ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d8","spk":"L","g":"f","en":"Yeah, I'm going to drive there.","cells":[{"ch":"對","py":"Duì","t":4,"s":"对","fc":[["u(e)i","hidden vowel: -ui = u(e)i, -iu = i(o)u, -un = u(e)n"]]},{"ch":"啊","py":"a","t":5,"pz":"，"},{"ch":"我","py":"wǒ","t":3,"mk":["half","↓","#3B5BDB"]},{"ch":"開","py":"kāi","t":1,"s":"开"},{"ch":"車","py":"chē","t":1,"s":"车"},{"ch":"去","py":"qù","t":4}],"cues":[{"chip":"u(e)i","lab":"duì","cue":"-ui = u(e)i, -iu = i(o)u, -un = u(e)n"},{"sym":"↓","col":"#3B5BDB","lab":"wǒ","cue":"zombie: stay low, no rise","kind":"half"}],"words":[{"t":"對","py":"duì","en":"yeah","s":"对"},{"t":"啊","py":"a","en":"particle"},{"t":"我","py":"wǒ","en":"I"},{"t":"開車","py":"kāi chē","en":"drive","s":"开车"},{"t":"去","py":"qù","en":"there"}],"audio":[{"src":"audio/Fd8.mp3","label":"對啊，我開車去 · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d9","spk":"M","g":"m","en":"When?","cells":[{"ch":"什","py":"Shén","t":2},{"ch":"麼","py":"me","t":5,"s":"么"},{"ch":"時","py":"shí","t":2,"s":"时"},{"ch":"候","py":"hòu","t":4,"pz":"？"}],"cues":[],"words":[{"t":"什麼","py":"shénme","en":"what","s":"什么"},{"t":"時候","py":"shíhòu","en":"time","s":"时候"}],"audio":[{"src":"audio/Fd9.mp3","label":"什麼時候？ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1,"note":"候: show notes print shíhòu (4th). In running speech 時候 is often shíhou, with a neutral 候. This take was not measured, so the cell keeps the show-note 4th."},{"id":"d10","spk":"L","g":"f","en":"We're going in just a second.","cells":[{"ch":"等","py":"Děng","t":3,"mk":["half","↓","#3B5BDB"]},{"ch":"一","py":"yī","t":1,"said":"yí","mk":["yi","↗","#17A398"]},{"ch":"下","py":"xià","t":4},{"ch":"就","py":"jiù","t":4,"mk":["p1","1","#C92A2A"]},{"ch":"要","py":"yào","t":4},{"ch":"去","py":"qù","t":4},{"ch":"了","py":"le","t":5}],"cues":[{"sym":"↓","col":"#3B5BDB","lab":"děng","cue":"zombie: stay low, no rise","kind":"half"},{"sym":"↗","col":"#17A398","lab":"yī xià","cue":"yī → yí before a 4th","kind":"yi"},{"sym":"1","col":"#C92A2A","lab":"j","cue":"Position 1: tip behind bottom teeth","kind":"p1"}],"words":[{"t":"等一下","py":"děng yí xià","en":"in a moment"},{"t":"就","py":"jiù","en":"right then"},{"t":"要","py":"yào","en":"going to"},{"t":"去","py":"qù","en":"go"},{"t":"了","py":"le","en":"particle"}],"audio":[{"src":"audio/Fd10.mp3","label":"等一下就要去了 · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d11","spk":"M","g":"m","en":"Do they have noodles too?","cells":[{"ch":"他","py":"Tā","t":1},{"ch":"們","py":"men","t":5,"s":"们"},{"ch":"也","py":"yě","t":3,"said":"yé","mk":["33","↗","#17A398"]},{"ch":"有","py":"yǒu","t":3,"mk":["half","↓","#3B5BDB"]},{"ch":"麵","py":"miàn","t":4,"s":"面"},{"ch":"嗎","py":"ma","t":5,"s":"吗","pz":"？"}],"cues":[{"sym":"↗","col":"#17A398","lab":"yě yǒu","cue":"3+3: say yé yǒu","kind":"33"},{"sym":"↓","col":"#3B5BDB","lab":"yǒu","cue":"zombie: stay low, no rise","kind":"half"}],"words":[{"t":"他們","py":"tāmen","en":"they","s":"他们"},{"t":"也","py":"yé","en":"also"},{"t":"有","py":"yǒu","en":"have"},{"t":"麵","py":"miàn","en":"noodles","s":"面"},{"t":"嗎","py":"ma","en":"question","s":"吗"}],"audio":[{"src":"audio/Fd11.mp3","label":"他們也有麵嗎？ · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d12","spk":"L","g":"f","en":"Sure.","cells":[{"ch":"有","py":"Yǒu","t":3},{"ch":"啊","py":"a","t":5}],"cues":[],"words":[{"t":"有","py":"yǒu","en":"have"},{"t":"啊","py":"a","en":"(yeah)"}],"audio":[{"src":"audio/Fd12.mp3","label":"有啊 · dialogue (natural)","real":true,"score":1.0,"ok":true,"kind":"nat"}],"buttons":1},{"id":"d13","spk":"M","g":"m","en":"All right then. Let's go togethe